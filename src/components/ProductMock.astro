---
import mark from '../assets/yura-favicon-tile.svg';
import { mockNav, mockStats, mockRows } from '../data/mock';
---

<div class="mock" style="margin-top:34px" aria-label="Vista de ejemplo del panel del docente en Yura">
	<div class="chrome">
		<img class="mark" src={mark.src} alt="" width="15" height="15" />
		<div class="crumbs">
			Mis cursos<span class="sl">/</span>Tu materia<span class="sl">/</span><b>Entregas</b>
		</div>
		<span class="av">TU</span>
	</div>
	<div class="body">
		<div class="side">
			{
				mockNav.map((entry) =>
					entry.group ? (
						<div class="grp">{entry.group}</div>
					) : (
						<div class:list={['it', entry.active && 'on']}>
							<span class="sq" />
							{entry.label}
							{entry.count && <span class="n">{entry.count}</span>}
						</div>
					)
				)
			}
		</div>
		<div class="main">
			<div class="kicker">Bandeja del curso · todas las entregas</div>
			<h3>Entregas</h3>
			<p class="note">
				<b>10 entregas por revisar</b> · 118 ya calificadas por Yura con feedback
			</p>
			<div class="stats">
				{
					mockStats.map((stat) => (
						<div class="stat">
							<div class="l">{stat.label}</div>
							<div class="v">
								{stat.value}
								{stat.unit && <small>{stat.unit}</small>}
							</div>
							<div class="d" style={stat.dimDetail ? 'color:var(--muted-fg)' : undefined}>
								{stat.detail}
							</div>
						</div>
					))
				}
			</div>
			<div class="rows">
				{
					mockRows.map((row) => (
						<div class="row">
							<span class="ini">{row.initials}</span>
							<div class="who">
								<div class="nm">{row.name}</div>
								<div class="mt">{row.meta}</div>
							</div>
							<div class="sc">
								<span class:list={['tag', row.tagTone]}>{row.tag}</span>
								<span class:list={['bar', row.barTone]}>
									<i style={`width:${row.score}%`} />
								</span>
								<span class="pct">{row.score}</span>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</div>
