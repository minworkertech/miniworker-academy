---
import { CTA_HREF, CTA_LABEL } from '../data/cta';
---

<section class="sec sec-tint" id="producto">
	<div class="wrap">
		<span class="eyebrow">Así funciona</span>
		<h2 class="t">De la destreza al .docx.</h2>
		<p class="lead">
			La micro cubre el trimestre entero y se entrega una vez por curso; el PUD cubre las semanas de
			una unidad y puedes tener varios. Los dos salen de la misma matriz.
		</p>

		<div class="video video--promo">
			<div class="ratio">
				<iframe
					id="promo-yura"
					src="/yura-promo.html"
					title="Video: de la destreza al documento con Yura"
					loading="lazy"
					allow="autoplay"
					scrolling="no"></iframe>
			</div>
		</div>

		<div class="engine">
			<b>¿En tu institución lo hacen distinto?</b>
			<span>
				Por ahora solo el formato del Ministerio, por trimestres. Si usan matriz propia, quimestres
				o parciales,{' '}
				<a href={CTA_HREF} data-cta="calendario">cuéntanoslo</a> y lo vemos contigo.
			</span>
		</div>

		<div class="demo-cta">
			<a class="btn primary" href={CTA_HREF} data-cta="demo">{CTA_LABEL}</a>
			<p class="micro">
				Sin tarjeta<span class="sep">·</span>Te avisamos del lanzamiento
			</p>
		</div>
	</div>
</section>

<style>
	.video--promo .ratio {
		display: block;
		padding: 0;
	}

	.video--promo iframe {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (max-width: 1023px) {
		.video--promo .ratio {
			aspect-ratio: 4 / 3;
		}
	}

	@media (max-width: 640px) {
		.video--promo .ratio {
			aspect-ratio: 2 / 3;
		}
	}

	/* el intro de la sección va a todo el ancho, no a la medida de lectura */
	.lead {
		max-width: none;
	}

</style>

<script>
	const frame = document.getElementById('promo-yura') as HTMLIFrameElement | null;

	if (frame) {
		const send = (message: string) => frame.contentWindow?.postMessage(message, location.origin);

		const wake = () => send('yura:audio');
		(['pointerdown', 'keydown', 'touchstart'] as const).forEach((event) =>
			document.addEventListener(event, wake, { passive: true })
		);

		let onScreen = false;

		const sync = () => send(onScreen && !document.hidden ? 'yura:visible' : 'yura:hidden');

		const observer = new IntersectionObserver(
			([entry]) => {
				const next = entry.isIntersecting && entry.intersectionRatio >= 0.35;
				if (next === onScreen) return;
				onScreen = next;
				sync();
			},
			{ threshold: [0, 0.35, 0.6] }
		);

		observer.observe(frame);
		frame.addEventListener('load', sync);
		document.addEventListener('visibilitychange', sync);
	}
</script>
