---
import logo from '../assets/yura-slogan-alineado.svg';

const currentYear = new Date().getFullYear();

const columns = [
	{
		title: 'Contacto',
		links: [
			{ label: 'yura.app', href: 'https://yura.app' },
			{ label: 'hola@yura.app', href: 'mailto:hola@yura.app' },
			{ label: 'Blog', href: '/blog' },
		],
	},
	{
		title: 'Producto',
		links: [
			{ label: 'Cómo funciona', href: '#demo' },
			{ label: 'Precios', href: '#precios' },
			{ label: 'Preguntas frecuentes', href: '#faq' },
		],
	},
];
---

<footer>
	<div class="wrap ft">
		<div class="cols">
			<div>
				<a class="logo" href="#top" style="margin-bottom:10px" aria-label="Yura">
					<img
						class="wordmark lema"
						src={logo.src}
						alt="Yura · Planifica. Automatiza. Enseña"
						width={logo.width}
						height={logo.height}
					/>
				</a>
				<p style="font-size:14px;color:var(--muted-fg);max-width:36ch">
					Un entorno de trabajo inteligente para docentes: tú pones tu materia, Yura arma los
					talleres y califica.
				</p>
			</div>
			{
				columns.map((column) => (
					<div>
						<div class="eyebrow dim" style="margin-bottom:8px">
							{column.title}
						</div>
						{column.links.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</div>
				))
			}
		</div>
		<div class="cr">© {currentYear} Yura · hecho en LATAM, para docentes de LATAM.</div>
	</div>
</footer>
