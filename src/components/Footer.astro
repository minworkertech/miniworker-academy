const defaultColumns: FooterColumn[] = [
	{
		title: 'Producto',
		links: [
			{ label: 'Así funciona', href: '#producto' },
			{ label: 'Precios', href: '#precios' },
			{ label: 'Preguntas frecuentes', href: '#faq' },
		],
	},
];

const {
	columns = defaultColumns,
	note = `© ${currentYear} Yura`,
} = Astro.props;
---

<footer>
	<div class="wrap ft">
		<div class="cols">
			<div class="brand-col">
				<a class="logo" href="#top" data-top aria-label="Yura">
					<img
						class="wordmark lema"
						src={logo.src}
						alt="Yura · Planifica. Automatiza. Enseña"
						width={logo.width}
						height={logo.height}
					/>
				</a>
				<NameMeaning />
			</div>
			{
				columns.map((column) => (
					<div>
						<div class="eyebrow dim" style="margin-bottom:8px">
							{column.title}
						</div>
						{column.links.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</div>
				))
			}
			<div class="social">
				<div class="eyebrow dim" style="margin-bottom:8px">Síguenos en redes</div>
				{
					socials.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.label}
						>
							<svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
								<path d={social.path} />
							</svg>
							{social.label}
						</a>
					))
				}
			</div>
		</div>
		<div class="cr">{note}</div>
	</div>
</footer>
