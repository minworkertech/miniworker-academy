---
interface FooterLink {
	label: string;
	href: string;
}

interface FooterColumn {
	title: string;
	links: FooterLink[];
}

interface Props {
	columns?: FooterColumn[];
	/** Línea de copyright. */
	note?: string;
}

import logo from '../assets/yura-slogan-alineado.svg';
import NameMeaning from './NameMeaning.astro';

