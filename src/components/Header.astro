---
import logo from '../assets/yura-principal.svg';
import { CTA_HREF, CTA_LABEL } from '../data/cta';
---

<header class="site">
	<div class="wrap hd">
		<a class="logo" href="#top" aria-label="Yura">
			<img
				class="wordmark"
				src={logo.src}
				alt="Yura"
				width={logo.width}
				height={logo.height}
			/>
		</a>
		<a class="btn primary" href={CTA_HREF} data-cta="header">{CTA_LABEL}</a>
	</div>
</header>
