---
import logo from '../assets/yura-principal.svg';
import ProductSwitcher from './ProductSwitcher.astro';
---

<header class="site">
	<div class="wrap hd">
		<a class="logo" href="#top" data-top aria-label="Yura">
			<img
				class="wordmark"
				src={logo.src}
				alt="Yura"
				width={logo.width}
				height={logo.height}
			/>
		</a>

		<ProductSwitcher />
	</div>
</header>
