---
import Tick from './Tick.astro';
import { plans, earlyOffer } from '../data/pricing';
import { CTA_HREF, CTA_LABEL } from '../data/cta';
---

<section class="sec" id="precios">
	<div class="wrap">
		<span class="eyebrow">Precios</span>
		<h2 class="t">Lo que es gratis y lo que se paga.</h2>
		<p class="offer"><Tick /><span>{earlyOffer}</span></p>
		<div class="plans">
			{
				plans.map((plan) => (
					<div class:list={['plan', plan.highlight && 'hi']}>
						{plan.highlight && <span class="ribbon">Empieza aquí</span>}
						<div class="nm">{plan.name}</div>
						<div class="pr">
							<span class="v">{plan.price}</span>
							<span class="u">· {plan.priceNote}</span>
						</div>
						<div class="alt">{plan.alt}</div>
						<p class="who">{plan.audience}</p>
						<ul>
							{plan.features.map((feature) => (
								<li>
									<Tick />
									<span set:html={feature} />
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<div class="demo-cta">
			<a class="btn primary" href={CTA_HREF} data-cta="precios">{CTA_LABEL}</a>
			<p class="micro">Sin tarjeta<span class="sep">·</span>Te avisamos del lanzamiento</p>
		</div>

		<div class="engine">
			<b>¿Eres vicerrectorado o coordinación?</b>
			<span>
				Cuentas para todo el colegio, los formatos cargados una sola vez y un panel de quién
				entregó.{' '}
				<a href={CTA_HREF} data-cta="precios-institucion">Escríbenos</a> y lo vemos contigo.
			</span>
		</div>
	</div>
</section>

<style>
	/* esta sección va a todo el ancho del contenedor */
	.offer,
	.plans {
		max-width: none;
	}

	.offer {
		margin-top: 22px;
		padding: 16px 18px;
		border-radius: var(--radius-lg);
		background: var(--teal-50);
		border: 1px solid var(--teal-200);
		font-size: 15px;
		font-weight: 500;
		display: flex;
		gap: 11px;
		align-items: flex-start;
	}

	.plan .who {
		font-size: 13.5px;
		color: var(--muted-fg);
		margin-top: 12px;
	}

	@media (min-width: 760px) {
		.plans {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
