---
import Tick from './Tick.astro';
const checks = [
	'Te escribimos el día del lanzamiento, sin llenarte la bandeja',
	'Los 5 primeros se llevan su primer trimestre completo gratis',
];
---

<section class="brand sec" id="crear-cuenta">
	<span class="blob v"></span><span class="blob i"></span><span class="blob s"></span>
	<div class="wrap two">
		<div>
			<span class="eyebrow">Lanzamiento</span>
			<h2 class="t">Regístrate para el lanzamiento.</h2>
			<ul class="checks" style="margin-top:22px">
				{
					checks.map((check) => (
						<li>
							<Tick />
							<span style="color:rgba(233,238,255,.78)">{check}</span>
						</li>
					))
				}
			</ul>
		</div>
		<div class="signup">
			<form class="form" id="signupForm" method="post" novalidate>
				<div class="field hideOnSent">
					<label for="su-email">Correo</label>
					<input
						class="inp"
						type="email"
						id="su-email"
						name="email"
						placeholder="tu.nombre@correo.com"
						autocomplete="email"
						required
					/>
				</div>
				<div class="field hideOnSent">
					<label for="su-materia">
						Mensaje <span class="opt">· opcional</span>
					</label>
					<textarea
						class="inp area"
						id="su-materia"
						name="subject"
						placeholder="qué enseñas, en qué nivel, o lo que necesites contarnos…"
						rows="3"></textarea>
				</div>
				<p class="err" id="signupErr">Escribe un correo válido.</p>
				<button class="btn onDark block hideOnSent" type="submit" id="signupSubmit">Enviar</button>
				<p class="micro hideOnSent" style="color:rgba(233,238,255,.6);text-align:center">
					Sin tarjeta<span class="sep">·</span>En español<span class="sep">·</span>Sin llamada de
					ventas
				</p>
				<p class="ok">
					<Tick />Listo. Te escribimos a tu correo el día del lanzamiento.
				</p>
			</form>
		</div>
	</div>
</section>

<style>
	.opt {
		font-weight: 500;
		color: rgba(233, 238, 255, 0.45);
	}

	.area {
		height: auto;
		padding: 12px 14px;
		line-height: 1.5;
		resize: vertical;
		font-family: var(--font-sans);
	}
</style>

<script>
	import { isEmail, submitToSheet } from '../scripts/waitlist';
	import { track } from '../scripts/track';

	const form = document.getElementById('signupForm') as HTMLFormElement | null;
	const emailInput = document.getElementById('su-email') as HTMLInputElement | null;
	const subjectInput = document.getElementById('su-materia') as HTMLTextAreaElement | null;
	const submitBtn = document.getElementById('signupSubmit') as HTMLButtonElement | null;
	const errorText = document.getElementById('signupErr');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!emailInput) return;

		const email = emailInput.value.trim();
		// el mensaje es opcional: solo el correo bloquea el envío
		const subject = subjectInput?.value.trim() ?? '';

		if (!isEmail(email)) {
			if (errorText) errorText.textContent = 'Escribe un correo válido.';
			form.classList.add('invalid');
			return;
		}

		form.classList.remove('invalid');
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = 'Enviando…';
		}

		try {
			await submitToSheet({ email, subject });
			track('signup_acceso_anticipado', { materia: subject.toLowerCase() });
			form.classList.add('sent');
		} catch {
			if (errorText) {
				errorText.textContent = 'No pudimos guardar tu registro. Inténtalo de nuevo.';
			}
			form.classList.add('invalid');
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Enviar';
			}
		}
	});
</script>
