---
import ProductMock from './ProductMock.astro';
import Tick from './Tick.astro';
import { CTA_HREF, CTA_LABEL } from '../data/cta';

const guarantees = [
	'Tus rúbricas, tus ponderaciones',
	'Exportas a Moodle',
	'En español, precio LATAM',
];
---

<section class="brand hero" id="hero">
	<span class="blob v"></span><span class="blob i"></span><span class="blob s"></span>
	<div class="wrap two">
		<div>
			<span class="pill"><span class="dot"></span>Acceso anticipado · cualquier materia</span>
			<h1>Tú pones tu materia. Yura arma los talleres y califica por ti.</h1>
			<p class="sub">
				Le das tu planificación y tus rúbricas, y Yura genera los talleres y evalúa cada entrega con
				IA —de cualquier materia y siguiendo tus formatos. <b>Recuperas tus noches</b>; tus
				estudiantes reciben feedback real.
			</p>
			<div class="cta">
				<a class="btn primary" href={CTA_HREF} data-cta="hero">{CTA_LABEL}</a>
				<p class="micro">Gratis para los primeros cursos<span class="sep">·</span>Sin tarjeta</p>
			</div>
			<div class="under">
				{
					guarantees.map((item) => (
						<span>
							<Tick />
							{item}
						</span>
					))
				}
			</div>
		</div>
		<div>
			<ProductMock />
			<p class="caption" style="color:rgba(233,238,255,.5)">vista de ejemplo del producto</p>
		</div>
	</div>
</section>
