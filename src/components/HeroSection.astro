---
import Tick from './Tick.astro';
import { CTA_HREF, CTA_LABEL } from '../data/cta';

const guarantees = ['La micro del trimestre y tus PUD', 'Descargas en .docx'];
---

<section class="brand hero" id="hero">
	<span class="blob v"></span><span class="blob i"></span><span class="blob s"></span>
	<div class="wrap two">
		<div>
			<span class="pill"><span class="dot"></span>Acceso anticipado · EGB y BGU</span>
			<h1>Recupera las horas que se te van planificando.</h1>
			<p class="sub">
				Eliges el curso y marcas las semanas: <b>Yura ya sabe cuáles te faltan</b>. Le dices el tema
				y sale la planificación completa —destrezas, indicadores, actividades y evaluación— lista
				para descargar en .docx.
			</p>
			<div class="cta">
				<a class="btn primary" href={CTA_HREF} data-cta="hero">{CTA_LABEL}</a>
				<p class="micro">
					Sin tarjeta<span class="sep">·</span>Te avisamos del lanzamiento
				</p>
			</div>
			<div class="under">
				{
					guarantees.map((item) => (
						<span>
							<Tick />
							{item}
						</span>
					))
				}
			</div>
		</div>
		<div>
			<img
				class="shot"
				src="/producto/semanas.webp"
				alt="Selección de las semanas que cubre la unidad, con las que faltan ya marcadas"
				width="1300"
				height="1179"
				loading="eager"
			/>
			<p class="caption" style="color:rgba(233,238,255,.5)">vista de ejemplo del producto</p>
		</div>
	</div>
</section>
