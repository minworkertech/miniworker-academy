---
import { faq } from '../data/faq';
---

<section class="sec sec-tint" id="faq">
	<div class="wrap">
		<span class="eyebrow">Preguntas</span>
		<h2 class="t">Lo que preguntan todos.</h2>
		<div class="faq">
			{
				faq.map((item) => (
					<details>
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	/* las respuestas van a todo el ancho de la sección */
	details p {
		max-width: none;
	}
</style>
