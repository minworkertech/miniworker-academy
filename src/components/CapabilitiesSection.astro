---
import Icon from './Icon.astro';
import { capabilities } from '../data/capabilities';
---

<section class="sec sec-tint" id="que-hace">
	<div class="wrap">
		<span class="eyebrow">Qué genera y qué mide Yura</span>
		<h2 class="t">Lo que hoy haces a mano, medido y repetible.</h2>
		<div class="grid2">
			{
				capabilities.map((item) => (
					<div class="card">
						<div class="ico">
							<Icon name={item.icon} />
						</div>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
