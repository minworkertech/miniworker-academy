---
import Tick from './Tick.astro';
import { CTA_HREF } from '../data/cta';
---

<section class="sec" id="novedades">
	<div class="wrap">
		<div class="news">
			<h3>¿Todavía no es el momento?</h3>
			<p>Te avisamos cuando abramos tu materia. Sin spam: solo novedades del producto.</p>
			<form class="form" id="newsForm" method="post" novalidate>
				<div class="field hideOnSent">
					<label for="nw-email" style="position:absolute;left:-9999px">Correo electrónico</label>
					<input
						class="inp"
						type="email"
						id="nw-email"
						name="email"
						placeholder="tu.nombre@universidad.edu"
						autocomplete="email"
						required
					/>
				</div>
				<p class="err" id="newsErr">Escribe un correo válido.</p>
				<button class="btn outline hideOnSent" type="submit" id="newsSubmit">
					Recibir novedades
				</button>
				<p class="ok"><Tick />Listo. Te escribimos cuando abramos tu materia.</p>
			</form>
			<p class="legal">
				Esto no crea tu cuenta. Si quieres empezar este semestre,{' '}
				<a href={CTA_HREF} data-cta="novedades">pide acceso anticipado</a>.
			</p>
		</div>
	</div>
</section>

<script>
	import { isEmail, submitToSheet } from '../scripts/waitlist';
	import { track } from '../scripts/track';

	const form = document.getElementById('newsForm') as HTMLFormElement | null;
	const emailInput = document.getElementById('nw-email') as HTMLInputElement | null;
	const submitBtn = document.getElementById('newsSubmit') as HTMLButtonElement | null;
	const errorText = document.getElementById('newsErr');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!emailInput) return;

		const email = emailInput.value.trim();
		if (!isEmail(email)) {
			if (errorText) errorText.textContent = 'Escribe un correo válido.';
			form.classList.add('invalid');
			return;
		}

		form.classList.remove('invalid');
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = 'Enviando…';
		}

		try {
			// Sin materia: la hoja guarda la columna Subject vacía para estos registros.
			await submitToSheet({ email });
			track('novedades_email');
			form.classList.add('sent');
		} catch {
			if (errorText) errorText.textContent = 'No pudimos guardar tu correo. Inténtalo de nuevo.';
			form.classList.add('invalid');
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Recibir novedades';
			}
		}
	});
</script>
