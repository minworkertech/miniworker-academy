---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import DemoSection from '../components/DemoSection.astro';
import PricingSection from '../components/PricingSection.astro';
import SignupSection from '../components/SignupSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<Layout>
	<Header />

	<main id="top">
		<HeroSection />
		<ProblemSection />
		<DemoSection />
		<PricingSection />
		<FaqSection />
		<SignupSection />
	</main>

	<Footer />
	<StickyCta />
</Layout>

<script>
	import { track } from '../scripts/track';

	document.querySelectorAll<HTMLElement>('[data-cta]').forEach((element) => {
		element.addEventListener('click', () => {
			track('cta_acceso_anticipado', { ubicacion: element.dataset.cta });
		});
	});
</script>
