---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import StepsSection from '../components/StepsSection.astro';
import DemoSection from '../components/DemoSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import SubjectsSection from '../components/SubjectsSection.astro';
import MethodologySection from '../components/MethodologySection.astro';
import WhyYuraSection from '../components/WhyYuraSection.astro';
import PricingSection from '../components/PricingSection.astro';
import NewsletterSection from '../components/NewsletterSection.astro';
import SignupSection from '../components/SignupSection.astro';
import HonestySection from '../components/HonestySection.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCtaSection from '../components/FinalCtaSection.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<Layout>
	<Header />

	<main id="top">
		<HeroSection />
		<ProblemSection />
		<StepsSection />
		<DemoSection />
		<CapabilitiesSection />
		<SubjectsSection />
		<MethodologySection />
		<WhyYuraSection />
		<PricingSection />
		<NewsletterSection />
		<SignupSection />
		<HonestySection />
		<FaqSection />
		<FinalCtaSection />
	</main>

	<Footer />
	<StickyCta />
</Layout>

<script>
	import { track } from '../scripts/track';

	document.querySelectorAll<HTMLElement>('[data-cta]').forEach((element) => {
		element.addEventListener('click', () => {
			track('cta_acceso_anticipado', { ubicacion: element.dataset.cta });
		});
	});
</script>
