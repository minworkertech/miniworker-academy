---
import '../styles/global.css';
import favicon from '../assets/yura-favicon-tile.svg';

interface Props {
	/** Texto de la pestaña del navegador. */
	title?: string;
	/** Titular al compartir en redes; puede ser más descriptivo que el de la pestaña. */
	socialTitle?: string;
	description?: string;
}

const {
	title = 'Yura · Planifica. Automatiza. Enseña',
	socialTitle = 'Yura · genera y califica tus talleres con IA, de cualquier materia',
	description = 'Le das tu materia y tu planificación; Yura arma los talleres y califica cada entrega con IA, en español y siguiendo tus formatos. Pide acceso anticipado.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={socialTitle} />
		<meta
			property="og:description"
			content="Tú pones tu materia. Yura arma los talleres y califica por ti. En español, con tus rúbricas y export a Moodle."
		/>
		<meta property="og:type" content="website" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<link rel="apple-touch-icon" href={favicon.src} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
